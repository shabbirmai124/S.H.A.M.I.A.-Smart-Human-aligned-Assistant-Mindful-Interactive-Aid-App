<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer dark bezel disk -->
    <path
        android:pathData="M54,18 A36,36 0 1,1 53.99,18 Z"
        android:fillColor="#0B131E"
        android:strokeColor="#1E3A52"
        android:strokeWidth="1.2" />

    <!-- 12 Major cardinal & ordinal dial ticks -->
    <path
        android:pathData="M54,20.5 L54,24.2 M54,83.8 L54,87.5 M20.5,54 L24.2,54 M83.8,54 L87.5,54 M37.25,25.0 L39.1,28.2 M68.9,79.8 L70.75,83.0 M25.0,37.25 L28.2,39.1 M79.8,68.9 L83.0,70.75 M25.0,70.75 L28.2,68.9 M79.8,39.1 L83.0,37.25 M37.25,83.0 L39.1,79.8 M68.9,28.2 L70.75,25.0"
        android:strokeColor="#29B6F6"
        android:strokeWidth="1.5"
        android:strokeLineCap="round" />

    <!-- Outer orbital telemetry arcs -->
    <path
        android:pathData="M33,36 A27.5,27.5 0 0,1 67,29.8"
        android:strokeColor="#38BDF8"
        android:strokeWidth="1.3"
        android:strokeLineCap="round" />
    <path
        android:pathData="M79.5,43.5 A27.5,27.5 0 0,1 77,69"
        android:strokeColor="#29B6F6"
        android:strokeWidth="1.3"
        android:strokeLineCap="round" />
    <path
        android:pathData="M68,77.8 A27.5,27.5 0 0,1 35,74"
        android:strokeColor="#38BDF8"
        android:strokeWidth="1.3"
        android:strokeLineCap="round" />
    <path
        android:pathData="M27,60 A27.5,27.5 0 0,1 28.5,43"
        android:strokeColor="#0284C7"
        android:strokeWidth="1.2"
        android:strokeLineCap="round" />

    <!-- Glowing orbital satellite nodes -->
    <path
        android:pathData="M49.5,25.2 A1.8,1.8 0 1,1 49.49,25.2 Z"
        android:fillColor="#7DD3FC" />
    <path
        android:pathData="M59.2,81.0 A1.6,1.6 0 1,1 59.19,81.0 Z"
        android:fillColor="#38BDF8" />

    <!-- Inner dark cavity & glowing cyan aperture ring -->
    <path
        android:pathData="M54,35.5 A18.5,18.5 0 1,1 53.99,35.5 Z"
        android:fillColor="#050A11"
        android:strokeColor="#1D6FA5"
        android:strokeWidth="1.4" />

    <!-- 3D Luminous Quantum Core Sphere -->
    <path android:pathData="M54,41.5 A12.5,12.5 0 1,1 53.99,41.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="52.5"
                android:centerY="52.0"
                android:gradientRadius="13.5">
                <item android:offset="0.0" android:color="#FFFFFF" />
                <item android:offset="0.28" android:color="#7DD3FC" />
                <item android:offset="0.65" android:color="#0284C7" />
                <item android:offset="1.0" android:color="#082F49" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Upper specular crescent highlight on the 3D sphere -->
    <path
        android:pathData="M45.5,46.8 A10.2,10.2 0 0,1 62.5,46.8"
        android:strokeColor="#BAE6FD"
        android:strokeWidth="1.1"
        android:strokeAlpha="0.85"
        android:strokeLineCap="round" />
</vector>
